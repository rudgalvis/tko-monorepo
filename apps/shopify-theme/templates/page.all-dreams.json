        "accordion_EA8R9J": {
          "type": "Accordion",
          "settings": {
            "dreamaccordionimage": "shopify://shop_images/Screenshot_2026-03-19_at_17.06.28.png",
            "dreamaccordionthumb": "shopify://shop_images/Screenshot_2026-03-19_at_17.06.28.png",
            "accordionheadingdream": "Jurgita",
            "accordionsubdream": "Aesthetic dental fillings",
            "accordioncopydream": "Jurgita has been part of our knitting family for quite some time, crafting many of your handmade favorites.\nHer dream was simple: a smile that shines as brightly as her spirit.\nThanks to your support, we teamed up with a dental clinic in Panevežys to help her make that dream come true with aesthetic sealing. Now, Jurgita's beautiful smile matches the warmth she's always shared with others.",
            "dreamurlcontrol": false,
            "fundurltext": "",
            "fundurl": "",
            "enablefund": false,
            "multiplier_fund": 5,
            "fundproduct": ""
          }
        },
        "accordion_8hYKah": {
          "type": "Accordion",
          "settings": {
            "dreamaccordionimage": "shopify://shop_images/Screenshot_2026-04-01_at_11.08.44.png",
            "dreamaccordionthumb": "shopify://shop_images/Screenshot_2026-04-01_at_11.08.44.png",
            "accordionheadingdream": "Svetlana",
            "accordionsubdream": "Sewing Machine",
            "accordioncopydream": "Svetlana has been part of our knitting family for years - a creative spirit whose love for making things started in childhood, sewing tiny outfits for her dolls before she ever picked up a pair of needles. Later, a friend at school taught her to knit, and she simply never stopped.\nHer dream was to return to her first passion and refresh her sewing skills so she could start creating her own clothes again.\nThanks to our Knitters' Dream Fund, we helped make that dream come true. Svetlana is now the proud owner of a new sewing machine and excited to bring her ideas to life, stitch by stitch.",
            "dreamurlcontrol": false,
            "fundurltext": "",
            "fundurl": "",
            "enablefund": false,
            "multiplier_fund": 5,
            "fundproduct": ""
          }
        },
        "accordion_Ya4Cfy": {
          "type": "Accordion",
          "settings": {
            "dreamaccordionimage": "shopify://shop_images/Screenshot_2026-03-20_at_12.34.22.png",
            "dreamaccordionthumb": "shopify://shop_images/Screenshot_2026-03-20_at_12.34.22.png",
            "accordionheadingdream": "Rūta",
            "accordionsubdream": "Pilgrimage",
            "accordioncopydream": "Ruta has been part of our knitting family for years - a curious soul with a love for\ndiscovering new places and stories. Ever since she was a child, travelling sparked her imagination, but life, family, and work often kept her close to home.\nHer dream was simple yet deeply personal: to finally explore somewhere far beyond her local town and reconnect with that sense of wonder she had growing up.\nThanks to our Knitters' Dream Fund, we helped make that dream come true. Ruta spent a week in Cyprus, taking in its culture, history, and food.\nHer favourite moments were the warmth of the people she met and the seaside views of Paphos - a trip she'll treasure for years to come.",
            "dreamurlcontrol": false,
            "fundurltext": "",
            "fundurl": "",
            "enablefund": false,
            "multiplier_fund": 5,
            "fundproduct": ""
          }
        },
        "accordion_rB67qn": {
          "type": "Accordion",
          "settings": {
            "dreamaccordionimage": "shopify://shop_images/Nijole-Fulfilled-Dream_848x1074_05123ea6-25f1-4f81-8a1d-86e0769ec3c2.webp",
            "dreamaccordionthumb": "shopify://shop_images/Screenshot_2026-04-01_at_10.47.11.png",
            "accordionheadingdream": "Nijolė",
            "accordionsubdream": "Nutritionist Consultations",
            "accordioncopydream": "Nijolė has been part of our knitting family for years - a calm, steady presence whose warmth you can feel in every stitch she makes.\nHer dream was to learn how to better care for her health through nutrition, especially while managing diabetes.\nThanks to our Knitters' Dream Fund, we helped make that dream come true. Nijolė is now working with a licensed dietitian to create a balanced meal plan that helps her feel her best.\nHearing her say how touched she was that\n\"others do care\" reminds us why this fund matters so much.",
            "dreamurlcontrol": false,
            "fundurltext": "",
            "fundurl": "",
            "enablefund": false,
            "multiplier_fund": 5,
            "fundproduct": ""
          }
        },
